Options -MultiViews
RewriteEngine On
RewriteBase /

# Route all requests that aren't real files or directories to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

# Serve index.html for 404s so React Router handles the route
ErrorDocument 404 /index.html
